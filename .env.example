# Formspree form endpoint for /proposer
# Create a form at https://formspree.io then paste:
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
PUBLIC_FORMSPREE_ENDPOINT=

# Google Search Console HTML-tag verification (meta content=…)
# PUBLIC_GOOGLE_SITE_VERIFICATION=paste_token_here
PUBLIC_GOOGLE_SITE_VERIFICATION=
