---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialPage from '../components/EditorialPage.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);
---

<BaseLayout title={t('legal.title')} description={t('legal.description')} lang={lang}>
  <EditorialPage title={t('legal.hero')} introduction={t('legal.intro')}>
    <div class="grid gap-12 md:grid-cols-12 md:gap-y-16">
      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('legal.edition.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('legal.edition.p1')}</p>
        <p class="mt-4 text-[15px] leading-7 text-earth-900/65">
          {t('legal.edition.p2')}{' '}
          <a
            href="https://likeur.xyz"
            target="_blank"
            rel="noreferrer"
            class="underline underline-offset-4 hover:text-mpichi-red"
          >
            likeur.xyz
          </a>.
        </p>
      </section>

      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('legal.hosting.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('legal.hosting.body')}</p>
      </section>

      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('legal.content.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('legal.content.body')}</p>
      </section>

      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('legal.liability.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('legal.liability.body')}</p>
      </section>
    </div>
  </EditorialPage>
</BaseLayout>
