---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialRecipeCard from '../../components/EditorialRecipeCard.astro';
import type { Locale } from '../../i18n/config';
import { localePath, localizeGuide, useTranslations } from '../../i18n/utils';
import { slugFromRecipeId } from '../../lib/recipe-theme';
import { absoluteUrl } from '../../lib/site';
import { pageCanonical, resolveOrigin } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: slugFromRecipeId(guide.id) },
    props: { guide, lang: 'fr' as Locale },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);
const { guide } = Astro.props;
const { Content } = await render(guide);
const localized = localizeGuide(guide, lang);
const origin = resolveOrigin(Astro.site);
const pageUrl = pageCanonical(Astro.url.pathname, origin);

const allRecipes = await getCollection('recettes');
const related = localized.relatedRecipes
  .map((slug) => allRecipes.find((recipe) => slugFromRecipeId(recipe.id) === slug))
  .filter((recipe): recipe is CollectionEntry<'recettes'> => Boolean(recipe));

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: localized.title,
  description: localized.description,
  image: [
    localized.image.startsWith('http')
      ? localized.image
      : absoluteUrl(localized.image, origin),
  ],
  url: pageUrl,
  inLanguage: lang === 'en' ? 'en' : 'fr',
  author: {
    '@type': 'Organization',
    name: 'Mpichi',
    url: absoluteUrl('/', origin),
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: absoluteUrl(localePath('/', lang), origin),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('guides.title'),
      item: absoluteUrl(localePath('/guides', lang), origin),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: localized.title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout
  title={localized.title}
  description={localized.description}
  lang={lang}
  image={localized.image}
  imageAlt={localized.imageAlt}
  type="article"
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <header class="relative min-h-[56svh] flex items-end overflow-hidden">
    <img
      src={localized.image}
      alt={localized.imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-black/30"></div>
      <div class="absolute inset-0 bg-linear-to-t from-earth-900 via-earth-900/35 to-earth-900/25"></div>
      <div class="absolute inset-0 image-grain"></div>
    </div>
    <div class="relative px-grid-margin max-w-[1200px] mx-auto w-full pt-36 pb-12 sm:pb-16">
      <a
        href={localePath('/guides', lang)}
        class="text-[9px] uppercase tracking-[.17em] text-creme-100/65 hover:text-white transition-colors"
        data-reveal
        style="--reveal-delay: 40ms"
      >
        {t('guides.back')}
      </a>
      <div class="mt-8 grid lg:grid-cols-12 gap-8 items-end" data-stagger>
        <div class="lg:col-span-8">
          <h1 class="text-display-hero">{localized.title}</h1>
        </div>
        <p class="lg:col-span-4 text-sm leading-6 text-creme-200/70 max-w-md">
          {localized.intro}
        </p>
      </div>
      <a
        href={localized.imageCreditUrl}
        target="_blank"
        rel="noreferrer"
        class="absolute right-grid-margin bottom-3 text-[8px] uppercase tracking-[.12em] text-white/45 hover:text-white/80"
      >
        {t('recipe.photo')} · {localized.imageCredit}
      </a>
    </div>
  </header>

  <article class="bg-creme-100 text-earth-900">
    <div class="px-grid-margin max-w-[720px] mx-auto py-12 sm:py-16">
      {
        lang === 'en' && localized.body ? (
          <div class="space-y-5 text-[15px] leading-7 text-earth-900/75 [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-light [&_h2]:text-earth-900">
            {localized.body.split('\n\n').map((block) =>
              block.startsWith('## ') ? (
                <h2>{block.slice(3)}</h2>
              ) : (
                <p>{block}</p>
              ),
            )}
          </div>
        ) : (
          <div class="space-y-5 text-[15px] leading-7 text-earth-900/75 [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-light [&_h2]:text-earth-900 [&_p]:text-[15px]">
            <Content />
          </div>
        )
      }
    </div>

    {
      related.length > 0 && (
        <div class="px-grid-margin max-w-[1200px] mx-auto pb-16 sm:pb-20">
          <div class="border-t border-earth-900/12 pt-12">
            <h2 class="font-display text-3xl font-light text-earth-900">{t('guides.relatedRecipes')}</h2>
            <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-14 list-none p-0 m-0">
              {related.map((recipe) => (
                <li>
                  <EditorialRecipeCard recipe={recipe} lang={lang} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
