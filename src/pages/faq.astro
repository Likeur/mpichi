---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialPage from '../components/EditorialPage.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);

const questions = [
  { question: t('faq.q1'), answer: t('faq.a1') },
  { question: t('faq.q2'), answer: t('faq.a2') },
  { question: t('faq.q3'), answer: t('faq.a3') },
  { question: t('faq.q4'), answer: t('faq.a4') },
  { question: t('faq.q5'), answer: t('faq.a5') },
  { question: t('faq.q6'), answer: t('faq.a6') },
  { question: t('faq.q7'), answer: t('faq.a7') },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer,
    },
  })),
};
---

<BaseLayout title={t('faq.title')} description={t('faq.description')} lang={lang} jsonLd={faqJsonLd}>
  <EditorialPage title={t('faq.hero')} introduction={t('faq.intro')}>
    <div class="divide-y divide-earth-900/15 border-y border-earth-900/15">
      {
        questions.map(({ question, answer }) => (
          <details class="group py-6" data-reveal>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-8">
              <span class="font-display text-2xl font-light sm:text-3xl">{question}</span>
              <span
                class="mt-1 text-xl text-mpichi-red transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="max-w-2xl pt-5 text-[15px] leading-7 text-earth-900/65">{answer}</p>
          </details>
        ))
      }
    </div>
  </EditorialPage>
</BaseLayout>
