---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialPage from '../components/EditorialPage.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);
---

<BaseLayout title={t('privacy.title')} description={t('privacy.description')} lang={lang}>
  <EditorialPage title={t('privacy.hero')} introduction={t('privacy.intro')}>
    <div class="grid gap-12 md:grid-cols-12 md:gap-y-16">
      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('privacy.data.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('privacy.data.body')}</p>
      </section>

      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('privacy.local.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('privacy.local.body')}</p>
      </section>

      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('privacy.external.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('privacy.external.body')}</p>
      </section>

      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('privacy.cookies.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">{t('privacy.cookies.body')}</p>
      </section>

      <section class="md:col-span-8" data-reveal>
        <h2 class="font-display text-3xl font-light">{t('privacy.contact.title')}</h2>
        <p class="mt-5 text-[15px] leading-7 text-earth-900/65">
          {t('privacy.contact.body')}{' '}
          <a
            href="https://likeur.xyz"
            target="_blank"
            rel="noreferrer"
            class="underline underline-offset-4 hover:text-mpichi-red"
          >
            likeur.xyz
          </a>.
        </p>
      </section>
    </div>
  </EditorialPage>
</BaseLayout>
