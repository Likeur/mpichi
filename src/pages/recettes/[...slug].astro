---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialRecipeCard from '../../components/EditorialRecipeCard.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import PillButton from '../../components/PillButton.astro';
import { slugFromRecipeId } from '../../lib/recipe-theme';
import type { Locale } from '../../i18n/config';
import type { UiKey } from '../../i18n/ui';
import { localePath, localizeRecipe, useTranslations } from '../../i18n/utils';
import RecipeVideo from '../../components/RecipeVideo.astro';
import RecipeVariants from '../../components/RecipeVariants.astro';
import { absoluteUrl, toIsoDuration } from '../../lib/site';
import { pageCanonical, resolveOrigin } from '../../lib/seo';
import { regionSlugFromKey } from '../../lib/taxonomy';
import { pickRelatedRecipes } from '../../lib/related-recipes';
import {
  youtubeEmbedUrl,
  youtubeThumbnailUrl,
  youtubeVideoId,
  youtubeWatchUrl,
} from '../../lib/youtube';



export async function getStaticPaths() {
  const recipes = await getCollection('recettes');
  return recipes.map((recipe) => ({
    params: { slug: slugFromRecipeId(recipe.id) },
    props: { recipe, lang: 'fr' as Locale },
  }));
}

interface Props {
  recipe: CollectionEntry<'recettes'>;
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);
const { recipe } = Astro.props;
const { Content } = await render(recipe);
const localized = localizeRecipe(recipe, lang);
const origin = resolveOrigin(Astro.site);
const pageUrl = pageCanonical(Astro.url.pathname, origin);
const catalogUrl = absoluteUrl(localePath('/recettes', lang), origin);
const regionSlug = regionSlugFromKey(recipe.data.region);
const regionHref = regionSlug ? localePath(`/regions/${regionSlug}`, lang) : undefined;
const categoryHref = localePath(`/categories/${localized.category}`, lang);
const categoryLabel = t(`category.${localized.category}` as UiKey);
const allRecipes = await getCollection('recettes');
const bySlug = new Map(allRecipes.map((entry) => [slugFromRecipeId(entry.id), entry]));
const curatedRelated = (recipe.data.relatedRecipes ?? [])
  .map((slug) => bySlug.get(slug))
  .filter((entry): entry is CollectionEntry<'recettes'> => Boolean(entry));
const related =
  curatedRelated.length > 0 ? curatedRelated.slice(0, 3) : pickRelatedRecipes(recipe, allRecipes, 3);
const peopleTemplate = t('recipe.people', { n: '__N__' });
const pageTitle = localized.seoTitle ?? localized.title;

const prepIso = toIsoDuration(localized.prepTime);
const cookIso = toIsoDuration(localized.cookTime);
const totalIso = (() => {
  const parse = (iso?: string) => {
    if (!iso) return 0;
    const h = Number(iso.match(/(\d+)H/)?.[1] ?? 0);
    const m = Number(iso.match(/(\d+)M/)?.[1] ?? 0);
    return h * 60 + m;
  };
  const total = parse(prepIso) + parse(cookIso);
  if (!total) return undefined;
  const hours = Math.floor(total / 60);
  const minutes = total % 60;
  if (hours && minutes) return `PT${hours}H${minutes}M`;
  if (hours) return `PT${hours}H`;
  return `PT${minutes}M`;
})();

const videoId = localized.video ? youtubeVideoId(localized.video.youtube) : undefined;
const videoObject =
  localized.video && videoId
    ? {
        '@type': 'VideoObject',
        name: localized.video.title,
        description: localized.description,
        thumbnailUrl: [youtubeThumbnailUrl(videoId)],
        contentUrl: youtubeWatchUrl(videoId),
        embedUrl: youtubeEmbedUrl(videoId),
      }
    : undefined;

const recipeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  '@id': pageUrl,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  name: localized.title,
  description: localized.description,
  image: [
    localized.image.startsWith('http')
      ? localized.image
      : absoluteUrl(localized.image, origin),
  ],
  author: {
    '@type': 'Organization',
    name: 'Mpichi',
    url: absoluteUrl('/', origin),
  },
  inLanguage: lang === 'en' ? 'en' : 'fr',
  recipeCategory: localized.category,
  recipeCuisine: lang === 'en' ? 'Congolese' : 'Congolaise',
  keywords: localized.tags.join(', '),
  recipeYield: String(localized.servings),
  prepTime: prepIso,
  cookTime: cookIso,
  ...(totalIso ? { totalTime: totalIso } : {}),
  recipeIngredient: localized.ingredients,
  recipeInstructions: localized.steps.map((text, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    text,
  })),
  ...(videoObject ? { video: videoObject } : {}),
  ...(localized.region
    ? {
        contentLocation: {
          '@type': 'Place',
          name: localized.region,
          containedInPlace: {
            '@type': 'Country',
            name: lang === 'en' ? 'Democratic Republic of the Congo' : 'République démocratique du Congo',
          },
        },
      }
    : {}),
};


const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: absoluteUrl(localePath('/', lang), origin),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('nav.recipes'),
      item: catalogUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: localized.title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={localized.description}
  lang={lang}
  image={localized.image}
  imageAlt={localized.imageAlt}
  type="article"
  jsonLd={[recipeJsonLd, breadcrumbJsonLd]}
>
  <header class="relative min-h-[70svh] flex items-end overflow-hidden" data-nav-surface="dark">
    <img
      src={localized.image.replace(/([?&]width=)\d+/, '$11200')}
      srcset={`${localized.image.replace(/([?&]width=)\d+/, '$1720')} 720w, ${localized.image.replace(/([?&]width=)\d+/, '$11200')} 1200w, ${localized.image.replace(/([?&]width=)\d+/, '$11600')} 1600w`}
      sizes="100vw"
      alt={localized.imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      style={`object-position: ${localized.imagePosition}`}
      width="1200"
      height="900"
      fetchpriority="high"
      decoding="async"
      data-recipe-hero
    />
    <div class="absolute inset-0 pointer-events-none" data-recipe-overlay>
      <div class="absolute inset-0 bg-black/25"></div>
      <div class="absolute inset-0 bg-linear-to-r from-earth-900/85 via-earth-900/40 to-transparent"></div>
      <div class="absolute inset-0 bg-linear-to-t from-earth-900 via-transparent to-earth-900/30"></div>
      <div class="absolute inset-0 image-grain"></div>
    </div>
    <div
      class="relative px-grid-margin max-w-[1200px] mx-auto w-full pt-36 pb-12 sm:pb-16"
      data-recipe-intro
    >
      <a
        href={localePath('/recettes', lang)}
        class="text-[9px] uppercase tracking-[.17em] text-creme-100/65 hover:text-white transition-colors"
        data-reveal
        style="--reveal-delay: 40ms"
        data-print-hide
      >
        {t('recipe.back')}
      </a>
      <div class="mt-10 grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8" data-stagger>
          <h1 class="text-display-hero">{localized.title}</h1>
          <p class="mt-6 text-base sm:text-lg text-creme-100/78 max-w-2xl leading-relaxed">
            {localized.description}
          </p>
        </div>
        <dl
          class="lg:col-span-3 lg:col-start-10 grid grid-cols-2 gap-y-5 gap-x-4 border-t border-creme-100/25 pt-5 text-[9px] uppercase tracking-[.14em] text-creme-100/65"
          data-reveal
          style="--reveal-delay: 210ms"
        >
          {
            localized.region && regionHref && (
              <div class="col-span-2">
                <dt class="text-creme-100/35">{t('recipe.region')}</dt>
                <dd class="mt-1 text-creme-100">
                  <a href={regionHref} class="hover:text-white transition-colors underline decoration-creme-100/25 underline-offset-4">
                    {localized.region}
                  </a>
                </dd>
              </div>
            )
          }
          <div class="col-span-2">
            <dt class="text-creme-100/35">{t('recipe.category')}</dt>
            <dd class="mt-1 text-creme-100">
              <a href={categoryHref} class="hover:text-white transition-colors underline decoration-creme-100/25 underline-offset-4">
                {categoryLabel}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-creme-100/35">{t('recipe.prep')}</dt>
            <dd class="mt-1 text-creme-100">{localized.prepTime}</dd>
          </div>
          <div>
            <dt class="text-creme-100/35">{t('recipe.cook')}</dt>
            <dd class="mt-1 text-creme-100">{localized.cookTime}</dd>
          </div>
          <div>
            <dt class="text-creme-100/35">{t('recipe.servings')}</dt>
            <dd class="mt-1 text-creme-100" data-servings-display>
              {t('recipe.people', { n: localized.servings })}
            </dd>
          </div>
          <div>
            <dt class="text-creme-100/35">{t('recipe.level')}</dt>
            <dd class="mt-1 text-creme-100 capitalize">{localized.difficulty}</dd>
          </div>
        </dl>
      </div>
      <a
        href={localized.imageCreditUrl}
        target="_blank"
        rel="noreferrer"
        class="absolute right-grid-margin bottom-3 text-[8px] uppercase tracking-[.12em] text-white/45 hover:text-white/80"
        data-reveal
        style="--reveal-delay: 300ms"
        data-print-hide
      >
        {t('recipe.photo')} · {localized.imageCredit}
      </a>
    </div>
  </header>

  <article
    class="bg-creme-100 text-earth-900"
    data-nav-surface="light"
    data-recipe-body
    data-recipe-tools
    data-locale={lang}
    data-base-servings={localized.servings}
    data-people-template={peopleTemplate}
    data-share-title={localized.title}
    data-share-text={localized.description}
    data-share-url={pageUrl}
    data-share-copied={t('recipe.shareCopied')}
  >
    <div class="px-grid-margin max-w-[1050px] mx-auto py-10 sm:py-16">
      <div
        class="mb-10 flex flex-col gap-5 border-b border-earth-900/12 pb-6 sm:flex-row sm:items-center sm:justify-between"
        data-print-hide
        data-reveal-static
      >
        <div
          class="flex items-center gap-3"
          role="group"
          aria-label={t('recipe.scale')}
        >
          <svg
            class="size-[18px] text-earth-900/55"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="9" cy="8" r="3.25" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="16.5" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"></circle>
            <path
              d="M3.5 18.5c.6-2.8 2.7-4.5 5.5-4.5s4.9 1.7 5.5 4.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
            <path
              d="M14.5 14.2c1.5-.5 3.2-.3 4.6.8.9.7 1.5 1.7 1.9 2.9"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
          </svg>
          <button
            type="button"
            data-servings-minus
            class="flex size-8 items-center justify-center text-earth-900/45 transition-colors hover:text-earth-900 disabled:pointer-events-none disabled:opacity-30"
            aria-label={t('recipe.decreaseServings')}
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </button>
          <span
            class="min-w-6 text-center font-display text-xl font-light tabular-nums text-earth-900"
            data-servings-count
            aria-live="polite"
          >
            {localized.servings}
          </span>
          <button
            type="button"
            data-servings-plus
            class="flex size-8 items-center justify-center text-earth-900/45 transition-colors hover:text-earth-900 disabled:pointer-events-none disabled:opacity-30"
            aria-label={t('recipe.increaseServings')}
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 3v8M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <div class="flex items-center gap-5">
          <FavoriteButton slug={localized.slug} lang={lang} variant="ink" showLabel />
          <button
            type="button"
            data-share
            class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[.16em] text-earth-900/45 transition-colors hover:text-earth-900"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="18" cy="5" r="2.5" stroke="currentColor" stroke-width="1.5"></circle>
              <circle cx="6" cy="12" r="2.5" stroke="currentColor" stroke-width="1.5"></circle>
              <circle cx="18" cy="19" r="2.5" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M8.2 10.8 15.8 6.7M8.2 13.2l7.6 4.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <span data-share-label>{t('recipe.share')}</span>
          </button>
          <button
            type="button"
            data-print
            class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[.16em] text-earth-900/45 transition-colors hover:text-earth-900"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M7 8V4h10v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M7 16H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              <path d="M7 13h10v7H7v-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
            </svg>
            <span>{t('recipe.print')}</span>
          </button>
        </div>
      </div>

      <div class="grid md:grid-cols-12 gap-14 md:gap-8" data-stagger>
        <section class="md:col-span-4" data-reveal-static>
          <h2 class="font-display text-3xl font-light">{t('recipe.ingredients')}</h2>
          <ul class="mt-6 space-y-3 text-earth-900/75 list-none p-0" data-stagger>
            {
              localized.ingredients.map((item) => (
                <li class="flex gap-3 border-b border-earth-900/8 pb-3">
                  <span class="text-mpichi-red shrink-0" aria-hidden="true">
                    ·
                  </span>
                  <span data-ingredient data-base={item}>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="md:col-span-7 md:col-start-6" data-reveal-static>
          <h2 class="font-display text-3xl font-light">{t('recipe.steps')}</h2>
          <ol class="mt-6 space-y-6 list-none p-0 counter-reset-none" data-stagger>
            {
              localized.steps.map((step, i) => (
                <li class="flex gap-4">
                  <span class="font-display text-xl text-mpichi-red/80 tabular-nums shrink-0">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-earth-900/75 leading-relaxed pt-0.5">{step}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      {
        localized.video && (
          <RecipeVideo
            youtube={localized.video.youtube}
            title={localized.video.title}
            credit={localized.video.credit}
            creditUrl={localized.video.creditUrl}
            lang={lang}
          />
        )
      }

      {
        lang === 'en' && localized.body ? (
          <div class="mt-16 pt-10 border-t border-earth-900/10 text-earth-900/75 leading-relaxed space-y-4 [&_p]:text-base">
            <p>{localized.body}</p>
          </div>
        ) : (
          Content && (
            <div class="mt-16 pt-10 border-t border-earth-900/10 text-earth-900/75 leading-relaxed space-y-4 [&_p]:text-base">
              <Content />
            </div>
          )
        )
      }

      <aside class="mt-12 max-w-2xl border-t border-earth-900/10 pt-8" data-reveal-static>
        <p class="text-[9px] uppercase tracking-[.16em] text-earth-900/40">{t('recipe.transmission')}</p>
        <p class="mt-3 text-sm leading-relaxed text-earth-900/60">{t('recipe.transmissionBody')}</p>
      </aside>

      <RecipeVariants variants={localized.variants} lang={lang} />

      {
        related.length > 0 && (
          <section class="mt-20 pt-12 border-t border-earth-900/12" data-recipe-related data-reveal-static>
            <div class="mb-10 max-w-xl">
              <h2 class="font-display text-3xl font-light text-earth-900">{t('recipe.related')}</h2>
              <p class="mt-3 text-sm leading-relaxed text-earth-900/55">{t('recipe.relatedIntro')}</p>
            </div>
            <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-14 list-none p-0 m-0">
              {related.map((item) => (
                <li>
                  <EditorialRecipeCard recipe={item} priority={false} lang={lang} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-16 pt-8 border-t border-earth-900/12" data-print-hide>
        <PillButton href={localePath('/recettes', lang)} label={t('recipe.backCta')} variant="ink" />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { trackEvent } from '../../lib/analytics';
  import { scaleIngredientText, scaleServings } from '../../lib/portions';

  function initRecipeTools() {
    const root = document.querySelector<HTMLElement>('[data-recipe-tools]');
    if (!root || root.dataset.toolsReady === 'true') return;
    root.dataset.toolsReady = 'true';

    const locale = (root.dataset.locale === 'en' ? 'en' : 'fr') as 'fr' | 'en';
    const baseServings = Math.max(1, Number(root.dataset.baseServings ?? 1) || 1);
    const minServings = 1;
    const maxServings = Math.max(baseServings * 4, 12);
    const peopleTemplate = root.dataset.peopleTemplate ?? '{n}';
    const shareTitle = root.dataset.shareTitle ?? document.title;
    const shareText = root.dataset.shareText ?? '';
    const shareUrl = root.dataset.shareUrl ?? window.location.href;
    const shareCopied = root.dataset.shareCopied ?? 'OK';

    const servingsDisplay = document.querySelector<HTMLElement>('[data-servings-display]');
    const servingsCount = root.querySelector<HTMLElement>('[data-servings-count]');
    const minusButton = root.querySelector<HTMLButtonElement>('[data-servings-minus]');
    const plusButton = root.querySelector<HTMLButtonElement>('[data-servings-plus]');
    const ingredients = [...root.querySelectorAll<HTMLElement>('[data-ingredient]')];
    const shareButton = root.querySelector<HTMLButtonElement>('[data-share]');
    const shareLabel = root.querySelector<HTMLElement>('[data-share-label]');
    const printButton = root.querySelector<HTMLButtonElement>('[data-print]');

    let servings = baseServings;

    const applyServings = (next: number) => {
      servings = Math.min(maxServings, Math.max(minServings, next));
      const factor = servings / baseServings;

      ingredients.forEach((item) => {
        const base = item.dataset.base ?? item.textContent ?? '';
        item.textContent = scaleIngredientText(base, factor, locale);
      });

      if (servingsCount) servingsCount.textContent = String(servings);
      if (servingsDisplay) {
        servingsDisplay.textContent = peopleTemplate.replace(
          '__N__',
          scaleServings(baseServings, factor, locale),
        );
      }
      if (minusButton) minusButton.disabled = servings <= minServings;
      if (plusButton) plusButton.disabled = servings >= maxServings;
    };

    minusButton?.addEventListener('click', () => applyServings(servings - 1));
    plusButton?.addEventListener('click', () => applyServings(servings + 1));
    applyServings(baseServings);

    shareButton?.addEventListener('click', async () => {
      const payload = { title: shareTitle, text: shareText, url: shareUrl };
      let method: 'native' | 'clipboard' | 'prompt' = 'clipboard';
      try {
        if (navigator.share) {
          await navigator.share(payload);
          method = 'native';
          trackEvent('recipe_share', { method, share_url: shareUrl });
          return;
        }
      } catch {
        /* user cancelled or share failed — fall through to clipboard */
      }

      try {
        await navigator.clipboard.writeText(shareUrl);
        method = 'clipboard';
        if (shareLabel) {
          const previous = shareLabel.textContent;
          shareLabel.textContent = shareCopied;
          window.setTimeout(() => {
            shareLabel.textContent = previous;
          }, 1600);
        }
      } catch {
        method = 'prompt';
        window.prompt(shareCopied, shareUrl);
      }
      trackEvent('recipe_share', { method, share_url: shareUrl });
    });

    printButton?.addEventListener('click', () => {
      trackEvent('recipe_print');
      window.print();
    });
  }

  initRecipeTools();
  document.addEventListener('astro:page-load', initRecipeTools);
</script>
