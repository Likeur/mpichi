---
import type { CollectionEntry } from 'astro:content';
import { slugFromRecipeId } from '../lib/recipe-theme';

interface Props {
  recipe: CollectionEntry<'recettes'>;
  priority?: boolean;
}

const { recipe, priority = false } = Astro.props;
const { title, description, region, image, imageAlt, imagePosition, prepTime, cookTime } = recipe.data;
const slug = slugFromRecipeId(recipe.id);
const cardImage = image.replace(/([?&]width=)\d+/, '$1' + '900');
---

<article class="group relative flex h-full flex-col">
  <a href={`/recettes/${slug}`} class="block overflow-hidden bg-aged-oak/10">
    <img
      src={cardImage}
      alt={imageAlt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      data-recipe-image
      class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
      style={`object-position: ${imagePosition}`}
    />
  </a>
  <h3 class="mt-5 font-display text-2xl sm:text-[1.75rem] font-light text-earth-900 leading-[1.05]">
    <a href={`/recettes/${slug}`} class="hover:text-mpichi-red transition-colors">{title}</a>
  </h3>
  {region && (
    <p class="mt-2 text-[9px] uppercase tracking-[.15em] text-earth-900/50">{region}</p>
  )}
  <p class="mt-3 text-sm leading-relaxed text-earth-900/62 line-clamp-2">{description}</p>
  <p class="mt-5 pt-3 border-t border-earth-900/10 text-[9px] uppercase tracking-[.14em] text-earth-900/45">
    {prepTime} de préparation · {cookTime} de cuisson
  </p>
</article>
