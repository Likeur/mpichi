---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { localePath, localizeRecipe, useTranslations } from '../i18n/utils';
import { regionSlugFromKey } from '../lib/taxonomy';
import FavoriteButton from './FavoriteButton.astro';

interface Props {
  recipe: CollectionEntry<'recettes'>;
  priority?: boolean;
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);
const { recipe, priority = false } = Astro.props;
const localized = localizeRecipe(recipe, lang);
const href = localePath(`/recettes/${localized.slug}`, lang);
const regionSlug = regionSlugFromKey(recipe.data.region);
const regionHref = regionSlug ? localePath(`/regions/${regionSlug}`, lang) : undefined;
const imageAt = (width: number) =>
  localized.image.replace(/([?&]width=)\d+/, `$1${width}`);
const cardImage = imageAt(720);
const cardSrcSet = `${imageAt(480)} 480w, ${imageAt(720)} 720w, ${imageAt(960)} 960w`;
---

<article class="group relative flex h-full flex-col">
  <div class="relative overflow-hidden bg-aged-oak/10">
    <a href={href} class="block">
      <img
        src={cardImage}
        srcset={cardSrcSet}
        alt={localized.imageAlt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        width="720"
        height="540"
        sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
        data-recipe-image
        class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
        style={`object-position: ${localized.imagePosition}`}
      />
    </a>
    <div class="absolute right-2.5 top-2.5 z-10" data-print-hide>
      <FavoriteButton slug={localized.slug} lang={lang} variant="overlay" />
    </div>
  </div>
  <h3 class="mt-5 font-display text-2xl sm:text-[1.75rem] font-light text-earth-900 leading-[1.05]">
    <a href={href} class="hover:text-mpichi-red transition-colors">{localized.title}</a>
  </h3>
  {
    localized.region && regionHref && (
      <p class="mt-2 text-[9px] uppercase tracking-[.15em] text-earth-900/50">
        <a href={regionHref} class="hover:text-earth-900 transition-colors">{localized.region}</a>
      </p>
    )
  }
  <p class="mt-3 text-sm leading-relaxed text-earth-900/62 line-clamp-2">{localized.description}</p>
  <p class="mt-5 pt-3 border-t border-earth-900/10 text-[9px] uppercase tracking-[.14em] text-earth-900/45">
    {t('recipes.meta', { prep: localized.prepTime, cook: localized.cookTime })}
  </p>
</article>
