---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { youtubeEmbedUrl, youtubeVideoId, youtubeWatchUrl } from '../lib/youtube';

interface Props {
  youtube: string;
  title: string;
  credit: string;
  creditUrl?: string;
  lang?: Locale;
}

const { youtube, title, credit, creditUrl, lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const videoId = youtubeVideoId(youtube);
const watchUrl = videoId ? youtubeWatchUrl(videoId) : undefined;
const embedUrl = videoId ? youtubeEmbedUrl(videoId) : undefined;
---

{
  videoId && watchUrl && embedUrl && (
    <section class="mt-16 pt-10 border-t border-earth-900/10" data-recipe-video data-reveal-static>
      <h2 class="font-display text-3xl font-light text-earth-900">{t('recipe.video')}</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-earth-900/55">{title}</p>
      <div class="relative mt-6 aspect-video max-w-3xl overflow-hidden bg-earth-900">
        <iframe
          src={embedUrl}
          title={title}
          class="absolute inset-0 h-full w-full border-0"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        />
      </div>
      <p class="mt-3 text-[9px] uppercase tracking-[.14em] text-earth-900/40">
        {t('recipe.videoCredit')} ·{' '}
        {creditUrl ? (
          <a
            href={creditUrl}
            target="_blank"
            rel="noreferrer"
            class="text-earth-900/55 underline decoration-earth-900/20 underline-offset-4 transition-colors hover:text-earth-900"
          >
            {credit}
          </a>
        ) : (
          <span class="text-earth-900/55">{credit}</span>
        )}
        {' · '}
        <a
          href={watchUrl}
          target="_blank"
          rel="noreferrer"
          class="text-earth-900/55 underline decoration-earth-900/20 underline-offset-4 transition-colors hover:text-earth-900"
        >
          {t('recipe.videoWatch')}
        </a>
      </p>
    </section>
  )
}
