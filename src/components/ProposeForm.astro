---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { SITE_CONTACT_EMAIL, SITE_WHATSAPP_URL } from '../lib/site';

interface Props {
  lang?: Locale;
  endpoint: string;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);
const { endpoint } = Astro.props;
const configured = Boolean(endpoint);
const mailtoPhotos = `mailto:${SITE_CONTACT_EMAIL}?subject=${encodeURIComponent(
  lang === 'en' ? 'Mpichi — dish photo' : 'Mpichi — photo de plat',
)}`;
---

{
  !configured && (
    <p
      class="mb-10 border border-earth-900/15 bg-creme-50 px-5 py-4 text-[14px] leading-6 text-earth-900/70"
      role="status"
    >
      {t('propose.notConfigured')}
    </p>
  )
}

<form
  class="grid gap-8"
  data-propose-form
  data-endpoint={endpoint}
  data-success={t('propose.success')}
  data-error={t('propose.error')}
  data-sending={t('propose.sending')}
  novalidate={!configured}
>
  {/* Formspree honeypot */}
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="_subject" value={t('propose.subject')} />
  <input type="hidden" name="locale" value={lang} />

  <div class="grid gap-8 sm:grid-cols-2">
    <label class="block">
      <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
        {t('propose.name')}
      </span>
      <input
        type="text"
        name="name"
        autocomplete="name"
        class="w-full border-0 border-b border-earth-900/25 bg-transparent py-3 text-sm text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
        placeholder={t('propose.namePlaceholder')}
      />
    </label>
    <label class="block">
      <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
        {t('propose.email')} <span aria-hidden="true">*</span>
      </span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        class="w-full border-0 border-b border-earth-900/25 bg-transparent py-3 text-sm text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
        placeholder={t('propose.emailPlaceholder')}
      />
    </label>
  </div>

  <label class="block">
    <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
      {t('propose.recipeTitle')} <span aria-hidden="true">*</span>
    </span>
    <input
      type="text"
      name="recipeTitle"
      required
      class="w-full border-0 border-b border-earth-900/25 bg-transparent py-3 text-sm text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
      placeholder={t('propose.recipeTitlePlaceholder')}
    />
  </label>

  <div class="grid gap-8 sm:grid-cols-2">
    <label class="block">
      <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
        {t('propose.region')}
      </span>
      <input
        type="text"
        name="region"
        class="w-full border-0 border-b border-earth-900/25 bg-transparent py-3 text-sm text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
        placeholder={t('propose.regionPlaceholder')}
      />
    </label>
    <label class="block">
      <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
        {t('propose.category')}
      </span>
      <select
        name="category"
        class="w-full appearance-none border-0 border-b border-earth-900/25 bg-transparent py-3 text-sm text-earth-900 outline-none transition-colors focus:border-earth-900"
      >
        <option value="">{t('propose.categoryEmpty')}</option>
        <option value="plat">{t('category.plat')}</option>
        <option value="accompagnement">{t('category.accompagnement')}</option>
        <option value="boisson">{t('category.boisson')}</option>
        <option value="dessert">{t('category.dessert')}</option>
      </select>
    </label>
  </div>

  <label class="block">
    <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
      {t('propose.ingredients')} <span aria-hidden="true">*</span>
    </span>
    <textarea
      name="ingredients"
      required
      rows="6"
      class="w-full resize-y border border-earth-900/15 bg-transparent px-4 py-3 text-sm leading-6 text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
      placeholder={t('propose.ingredientsPlaceholder')}
    ></textarea>
  </label>

  <label class="block">
    <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
      {t('propose.steps')} <span aria-hidden="true">*</span>
    </span>
    <textarea
      name="steps"
      required
      rows="8"
      class="w-full resize-y border border-earth-900/15 bg-transparent px-4 py-3 text-sm leading-6 text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
      placeholder={t('propose.stepsPlaceholder')}
    ></textarea>
  </label>

  <label class="block">
    <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
      {t('propose.notes')}
    </span>
    <textarea
      name="notes"
      rows="4"
      class="w-full resize-y border border-earth-900/15 bg-transparent px-4 py-3 text-sm leading-6 text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
      placeholder={t('propose.notesPlaceholder')}
    ></textarea>
  </label>

  <label class="block">
    <span class="mb-3 block text-[9px] uppercase tracking-[.16em] text-earth-900/45">
      {t('propose.photo')}
    </span>
    <input
      type="url"
      name="photoUrl"
      class="w-full border-0 border-b border-earth-900/25 bg-transparent py-3 text-sm text-earth-900 outline-none transition-colors placeholder:text-earth-900/35 focus:border-earth-900"
      placeholder={t('propose.photoPlaceholder')}
    />
    <span class="mt-2 block text-[12px] leading-5 text-earth-900/45">{t('propose.photoHint')}</span>
  </label>

  <p class="text-[13px] leading-6 text-earth-900/65">
    {t('propose.photoContact')}{' '}
    <a
      href={mailtoPhotos}
      class="underline decoration-earth-900/25 underline-offset-4 transition-colors hover:text-earth-900"
    >
      {t('propose.photoContactEmail')}
    </a>
    {' '}
    {t('propose.photoContactOr')}
    {' '}
    <a
      href={SITE_WHATSAPP_URL}
      target="_blank"
      rel="noreferrer"
      class="underline decoration-earth-900/25 underline-offset-4 transition-colors hover:text-earth-900"
    >
      WhatsApp
    </a>
    .
  </p>

  <p class="text-[12px] leading-5 text-earth-900/45">{t('propose.moderation')}</p>

  <div class="flex flex-wrap items-center gap-5 pt-2">
    <button
      type="submit"
      data-propose-submit
      disabled={!configured}
      class="inline-flex items-center gap-3 bg-earth-900 px-6 py-3.5 text-[10px] font-medium uppercase tracking-[.16em] text-creme-100 transition-colors hover:bg-aged-oak disabled:cursor-not-allowed disabled:opacity-40"
    >
      <span data-propose-submit-label>{t('propose.submit')}</span>
    </button>
    <p
      data-propose-status
      class="text-[13px] leading-5 text-earth-900/65"
      role="status"
      aria-live="polite"
      hidden
    ></p>
  </div>
</form>

<script>
  import { trackEvent } from '../lib/analytics';

  function initProposeForm() {
    const form = document.querySelector<HTMLFormElement>('[data-propose-form]');
    if (!form || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    const endpoint = form.dataset.endpoint ?? '';
    const submit = form.querySelector<HTMLButtonElement>('[data-propose-submit]');
    const label = form.querySelector<HTMLElement>('[data-propose-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-propose-status]');
    if (!submit || !label || !status) return;

    const defaultLabel = label.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!endpoint) return;

      status.hidden = false;
      status.textContent = form.dataset.sending ?? '';
      status.classList.remove('text-mpichi-red');
      submit.disabled = true;
      label.textContent = form.dataset.sending ?? defaultLabel;

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (!response.ok) throw new Error('submit_failed');

        form.reset();
        status.textContent = form.dataset.success ?? '';
        trackEvent('propose_submit', {
          recipe_title: String(data.recipeTitle ?? '').slice(0, 120),
          recipe_region: String(data.region ?? '').slice(0, 80),
          recipe_category: String(data.category ?? ''),
          locale: String(data.locale ?? ''),
        });
      } catch {
        status.textContent = form.dataset.error ?? '';
        status.classList.add('text-mpichi-red');
      } finally {
        submit.disabled = false;
        label.textContent = defaultLabel;
      }
    });
  }

  initProposeForm();
  document.addEventListener('astro:page-load', initProposeForm);
</script>
