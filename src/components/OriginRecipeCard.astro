---
import type { CollectionEntry } from 'astro:content';
import { slugFromRecipeId } from '../lib/recipe-theme';

interface Props {
  recipe: CollectionEntry<'recettes'>;
}

const { recipe } = Astro.props;
const { title, region, image, imageAlt, imagePosition } = recipe.data;
const slug = slugFromRecipeId(recipe.id);
---

<a
  href={`/recettes/${slug}`}
  class="group flex w-[72vw] max-w-[330px] sm:w-[310px] lg:w-[340px] shrink-0 flex-col snap-start"
>
  <div
    class="relative aspect-[4/5] overflow-hidden bg-aged-oak"
  >
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      data-recipe-image
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.035]"
      style={`object-position: ${imagePosition}`}
    />
    <div class="absolute inset-0 bg-linear-to-t from-black/45 via-transparent to-transparent" />
  </div>
  <p class="mt-4 font-display text-2xl font-light text-creme-100 leading-tight group-hover:text-white transition-colors">
    {title}
  </p>
  <div class="mt-3 flex items-baseline justify-between gap-4">
    <p class="text-[9px] uppercase tracking-[.16em] text-creme-300/65">{region}</p>
    <span class="h-px flex-1 bg-creme-200/15"></span>
    <span class="text-creme-200/55 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
  </div>
</a>
