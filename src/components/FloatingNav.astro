---
import { locales, localeLabels, localeNames, type Locale } from '../i18n/config';
import { useTranslations, localePath, switchLocalePath, stripLocaleFromPath } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const lang = Astro.props.lang ?? 'fr';
const t = useTranslations(lang);
const path = Astro.url.pathname;
const bare = stripLocaleFromPath(path);
const isHome = bare === '/';
const isRecettes = bare.startsWith('/recettes');
const isFavorites = bare.startsWith('/favoris');
const isPropose = bare.startsWith('/proposer');
const isGuides = bare.startsWith('/guides');
const langOptions = locales.map((locale) => ({
  locale,
  label: localeNames[locale],
  href: switchLocalePath(path, locale),
  current: locale === lang,
}));

const mobileLinks = [
  { href: localePath('/', lang), label: t('nav.home'), active: isHome },
  { href: localePath('/recettes', lang), label: t('nav.recipes'), active: isRecettes },
  { href: localePath('/favoris', lang), label: t('nav.favorites'), active: isFavorites },
  { href: localePath('/proposer', lang), label: t('nav.propose'), active: isPropose },
  { href: localePath('/guides', lang), label: t('guides.title'), active: isGuides },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 pointer-events-none"
  data-print-hide
  data-site-nav
  data-nav-hidden="false"
  data-nav-on="dark"
>
  <!-- Transform only the bar — not the mobile panel (fixed + parent transform breaks the overlay). -->
  <div
    class="relative z-50 transition-transform duration-300 ease-out will-change-transform data-[nav-hidden=true]:-translate-y-full"
    data-nav-bar
    data-nav-hidden="false"
  >
  <div class="px-grid-margin pt-5 pointer-events-auto">
    <div class="mx-auto max-w-[1200px] relative flex items-center justify-center min-h-14">
      <!-- Desktop -->
      <nav
        class="nav-ink hidden md:flex h-14 w-full items-center justify-between gap-2 text-[10px] font-medium uppercase tracking-[0.16em] transition-colors duration-200"
        aria-label={t('nav.label')}
      >
        <div class="flex flex-1 items-center gap-5 min-w-0">
          <a
            href={localePath('/', lang)}
            class:list={['nav-ink-link transition-colors truncate', isHome && 'nav-ink-active']}
          >
            {t('nav.home')}
          </a>
        </div>

        <div class="w-18 shrink-0" aria-hidden="true"></div>

        <div class="flex flex-1 items-center justify-end gap-5 min-w-0">
          <a
            href={localePath('/recettes', lang)}
            class:list={['nav-ink-link transition-colors', isRecettes && 'nav-ink-active']}
          >
            {t('nav.recipes')}
          </a>
          <a
            href={localePath('/favoris', lang)}
            class:list={[
              'nav-ink-link relative inline-flex items-center gap-1.5 transition-colors',
              isFavorites && 'nav-ink-active',
            ]}
            data-nav-favorites
            data-favorites-label={t('nav.favorites')}
          >
            {t('nav.favorites')}
            <span
              data-favorites-badge
              hidden
              class="inline-flex min-w-4 items-center justify-center rounded-full bg-mpichi-red px-1 py-0.5 text-[8px] font-medium leading-none tracking-normal text-white tabular-nums"
              aria-hidden="true"
            ></span>
          </a>
          <a
            href={localePath('/proposer', lang)}
            class:list={['nav-ink-link transition-colors', isPropose && 'nav-ink-active']}
          >
            {t('nav.propose')}
          </a>
          <div class="relative" data-lang-menu>
            <button
              type="button"
              class="nav-ink-muted inline-flex items-center gap-1 transition-colors"
              aria-label={t('nav.lang')}
              aria-expanded="false"
              aria-haspopup="listbox"
              data-lang-menu-trigger
            >
              <span data-lang-menu-label>{localeLabels[lang]}</span>
              <svg
                viewBox="0 0 12 12"
                class="size-2.5 opacity-70 transition-transform duration-200 data-[open=true]:rotate-180"
                aria-hidden="true"
                data-lang-menu-chevron
                data-open="false"
              >
                <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <div
              class="absolute right-0 top-[calc(100%+0.55rem)] z-50 min-w-[7.5rem] origin-top-right rounded-sm border border-white/12 bg-earth-900/95 py-1 shadow-[0_12px_28px_rgba(0,0,0,.28)] opacity-0 pointer-events-none transition-[opacity,transform] duration-150 data-[state=open]:opacity-100 data-[state=open]:pointer-events-auto data-[state=closed]:scale-[0.98] data-[state=open]:scale-100"
              data-lang-menu-panel
              data-state="closed"
              hidden
              role="listbox"
              aria-label={t('nav.lang')}
            >
              {
                langOptions.map((option) => (
                  <a
                    href={option.href}
                    class:list={[
                      'block px-3 py-1.5 text-[11px] font-medium tracking-wide transition-colors',
                      option.current
                        ? 'text-white'
                        : 'text-creme-100/55 hover:text-white',
                    ]}
                    role="option"
                    aria-selected={option.current}
                    hreflang={option.locale}
                    data-lang-switch
                    data-nav-link={option.current ? undefined : ''}
                  >
                    {option.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </nav>

      <!-- Mobile bar -->
      <div class="flex md:hidden h-14 w-full items-center justify-between">
        <div class="relative z-10" data-lang-menu>
          <button
            type="button"
            class="nav-ink-muted inline-flex items-center gap-1 text-[10px] font-medium uppercase tracking-[0.16em] transition-colors"
            aria-label={t('nav.lang')}
            aria-expanded="false"
            aria-haspopup="listbox"
            data-lang-menu-trigger
          >
            <span data-lang-menu-label>{localeLabels[lang]}</span>
            <svg
              viewBox="0 0 12 12"
              class="size-2.5 opacity-70 transition-transform duration-200 data-[open=true]:rotate-180"
              aria-hidden="true"
              data-lang-menu-chevron
              data-open="false"
            >
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div
            class="absolute left-0 top-[calc(100%+0.55rem)] z-50 min-w-[7.5rem] origin-top-left rounded-sm border border-white/12 bg-earth-900/95 py-1 shadow-[0_12px_28px_rgba(0,0,0,.28)] opacity-0 pointer-events-none transition-[opacity,transform] duration-150 data-[state=open]:opacity-100 data-[state=open]:pointer-events-auto data-[state=closed]:scale-[0.98] data-[state=open]:scale-100"
            data-lang-menu-panel
            data-state="closed"
            hidden
            role="listbox"
            aria-label={t('nav.lang')}
          >
            {
              langOptions.map((option) => (
                <a
                  href={option.href}
                  class:list={[
                    'block px-3 py-1.5 text-[11px] font-medium tracking-wide transition-colors',
                    option.current
                      ? 'text-white'
                      : 'text-creme-100/55 hover:text-white',
                  ]}
                  role="option"
                  aria-selected={option.current}
                  hreflang={option.locale}
                  data-lang-switch
                >
                  {option.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="w-11" aria-hidden="true"></div>

        <button
          type="button"
          class="nav-ink relative z-10 flex size-11 items-center justify-center transition-colors duration-200"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label={t('nav.open')}
          data-label-open={t('nav.open')}
          data-label-close={t('nav.close')}
        >
          <span class="sr-only" data-nav-toggle-label>{t('nav.open')}</span>
          <span class="relative block h-3.5 w-5" aria-hidden="true">
            <span
              data-nav-line="top"
              class="absolute left-0 top-0 h-px w-full bg-current transition-transform duration-200 origin-center"
            ></span>
            <span
              data-nav-line="mid"
              class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current transition-opacity duration-200"
            ></span>
            <span
              data-nav-line="bot"
              class="absolute left-0 bottom-0 h-px w-full bg-current transition-transform duration-200 origin-center"
            ></span>
          </span>
        </button>
      </div>

      <a
        href={localePath('/', lang)}
        class="absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2 flex h-[66px] w-[54px] items-center justify-center transition-transform hover:-translate-y-[52%]"
        aria-label={t('nav.logo')}
        data-nav-logo
      >
        <svg viewBox="0 0 54 66" class="h-full w-full drop-shadow-[0_8px_18px_rgba(0,0,0,.35)]" aria-hidden="true">
          <path d="M27 2C38 2 47 11 47 22v20c0 11-9 20-20 20S7 53 7 42V22C7 11 16 2 27 2Z" fill="#c91f32"></path>
          <path d="M15 21c7-5 17-5 24 0" stroke="#efe5da" stroke-width="1.2" stroke-linecap="round" opacity=".7"></path>
          <text
            x="27"
            y="43"
            text-anchor="middle"
            fill="#f5f0e9"
            font-family="Georgia, serif"
            font-size="24"
            font-weight="500">M</text
          >
        </svg>
      </a>
    </div>
  </div>
  </div>

  <!-- Mobile panel: sibling of the bar so it stays viewport-fixed with a solid backdrop -->
  <div
    id="mobile-nav-panel"
    class="md:hidden fixed inset-0 z-40 min-h-dvh bg-earth-900 text-creme-100 opacity-0 pointer-events-none transition-opacity duration-300 data-[state=open]:opacity-100 data-[state=open]:pointer-events-auto"
    data-nav-panel
    data-state="closed"
    hidden
  >
    <nav
      class="flex h-full min-h-dvh flex-col px-grid-margin pb-10 pt-28"
      aria-label={t('nav.label')}
    >
      <ul class="mt-8 flex flex-1 flex-col justify-center gap-1 list-none p-0 m-0">
        {
          mobileLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'inline-flex items-center gap-3 py-3 font-display text-4xl font-light tracking-tight transition-colors',
                  link.active ? 'text-white' : 'text-creme-100/70 hover:text-white',
                ]}
                data-nav-link
                {...(link.href.includes('/favoris')
                  ? { 'data-nav-favorites': '', 'data-favorites-label': link.label }
                  : {})}
                aria-current={link.active ? 'page' : undefined}
              >
                {link.label}
                {link.href.includes('/favoris') && (
                  <span
                    data-favorites-badge
                    hidden
                    class="inline-flex min-w-5 items-center justify-center rounded-full bg-mpichi-red px-1.5 py-1 text-[10px] font-medium leading-none tracking-normal text-white tabular-nums"
                    aria-hidden="true"
                  ></span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="relative w-fit" data-lang-menu>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[0.18em] text-creme-100/45 hover:text-white transition-colors"
          aria-label={t('nav.lang')}
          aria-expanded="false"
          aria-haspopup="listbox"
          data-lang-menu-trigger
        >
          <span data-lang-menu-label>{localeLabels[lang]}</span>
          <svg
            viewBox="0 0 12 12"
            class="size-2.5 opacity-70 transition-transform duration-200 data-[open=true]:rotate-180"
            aria-hidden="true"
            data-lang-menu-chevron
            data-open="false"
          >
            <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div
          class="absolute left-0 bottom-[calc(100%+0.55rem)] z-50 min-w-[7.5rem] origin-bottom-left rounded-sm border border-white/12 bg-earth-950 py-1 shadow-[0_12px_28px_rgba(0,0,0,.28)] opacity-0 pointer-events-none transition-[opacity,transform] duration-150 data-[state=open]:opacity-100 data-[state=open]:pointer-events-auto data-[state=closed]:scale-[0.98] data-[state=open]:scale-100"
          data-lang-menu-panel
          data-state="closed"
          hidden
          role="listbox"
          aria-label={t('nav.lang')}
        >
          {
            langOptions.map((option) => (
              <a
                href={option.href}
                class:list={[
                  'block px-3 py-1.5 text-[12px] font-medium tracking-wide transition-colors',
                  option.current
                    ? 'text-white'
                    : 'text-creme-100/45 hover:text-white',
                ]}
                role="option"
                aria-selected={option.current}
                hreflang={option.locale}
                data-nav-link
                data-lang-switch
              >
                {option.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  function initSiteNav() {
    const root = document.querySelector<HTMLElement>('[data-site-nav]');
    if (!root) return;

    type NavWindow = Window & { __mpichiNavCleanup?: () => void };
    const navWindow = window as NavWindow;
    navWindow.__mpichiNavCleanup?.();

    const getLangMenus = () => [...root.querySelectorAll<HTMLElement>('[data-lang-menu]')];
    const closeLangMenu = (menu: HTMLElement) => {
      const trigger = menu.querySelector<HTMLButtonElement>('[data-lang-menu-trigger]');
      const langPanel = menu.querySelector<HTMLElement>('[data-lang-menu-panel]');
      const chevron = menu.querySelector<HTMLElement>('[data-lang-menu-chevron]');
      if (!trigger || !langPanel) return;
      trigger.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.dataset.open = 'false';
      langPanel.dataset.state = 'closed';
      langPanel.hidden = true;
    };
    const closeAllLangMenus = (except?: HTMLElement) => {
      getLangMenus().forEach((menu) => {
        if (menu !== except) closeLangMenu(menu);
      });
    };
    const openLangMenu = (menu: HTMLElement) => {
      closeAllLangMenus(menu);
      const trigger = menu.querySelector<HTMLButtonElement>('[data-lang-menu-trigger]');
      const langPanel = menu.querySelector<HTMLElement>('[data-lang-menu-panel]');
      const chevron = menu.querySelector<HTMLElement>('[data-lang-menu-chevron]');
      if (!trigger || !langPanel) return;
      trigger.setAttribute('aria-expanded', 'true');
      if (chevron) chevron.dataset.open = 'true';
      langPanel.hidden = false;
      requestAnimationFrame(() => {
        langPanel.dataset.state = 'open';
      });
    };

    const onLangTriggerClick = (event: Event) => {
      event.stopPropagation();
      const trigger = event.currentTarget as HTMLButtonElement;
      const menu = trigger.closest<HTMLElement>('[data-lang-menu]');
      if (!menu) return;
      const open = trigger.getAttribute('aria-expanded') === 'true';
      if (open) closeLangMenu(menu);
      else openLangMenu(menu);
    };

    getLangMenus().forEach((menu) => {
      const trigger = menu.querySelector<HTMLButtonElement>('[data-lang-menu-trigger]');
      trigger?.addEventListener('click', onLangTriggerClick);
    });

    const onLangOutsideClick = (event: MouseEvent) => {
      const target = event.target as Node | null;
      if (!target || getLangMenus().some((menu) => menu.contains(target))) return;
      closeAllLangMenus();
    };

    const toggle = root.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-nav-panel]');
    const label = root.querySelector<HTMLElement>('[data-nav-toggle-label]');
    const lines = {
      top: root.querySelector<HTMLElement>('[data-nav-line="top"]'),
      mid: root.querySelector<HTMLElement>('[data-nav-line="mid"]'),
      bot: root.querySelector<HTMLElement>('[data-nav-line="bot"]'),
    };

    if (!toggle || !panel) {
      document.addEventListener('click', onLangOutsideClick);
      navWindow.__mpichiNavCleanup = () => {
        document.removeEventListener('click', onLangOutsideClick);
        getLangMenus().forEach((menu) => {
          menu
            .querySelector<HTMLButtonElement>('[data-lang-menu-trigger]')
            ?.removeEventListener('click', onLangTriggerClick);
        });
      };
      return;
    }

    const openLabel = toggle.dataset.labelOpen ?? 'Menu';
    const closeLabel = toggle.dataset.labelClose ?? 'Close';

    const bar = root.querySelector<HTMLElement>('[data-nav-bar]');

    const LIGHT_CLASS = /\bbg-creme-(?:50|100|200)\b/;
    const DARK_CLASS = /\bbg-earth-(?:dark|900)\b|\bbg-aged-oak(?:-soft)?\b/;

    const classListOf = (el: Element) => {
      if (typeof el.className === 'string') return el.className;
      return el.getAttribute('class') ?? '';
    };

    const ownSurface = (el: Element): 'light' | 'dark' | null => {
      if (el instanceof HTMLElement) {
        const explicit = el.dataset.navSurface;
        if (explicit === 'light' || explicit === 'dark') return explicit;
      }
      const cls = classListOf(el);
      if (LIGHT_CLASS.test(cls)) return 'light';
      if (DARK_CLASS.test(cls)) return 'dark';
      return null;
    };

    const surfaceNodes = () =>
      document.querySelectorAll<HTMLElement>(
        '[data-nav-surface], section, article, [data-recipe-hero], [data-hero]',
      );

    // Lenis/Locomotive often skip native scroll events — read geometry instead.
    const updateTone = () => {
      if (document.documentElement.classList.contains('nav-open')) {
        root.dataset.navOn = 'dark';
        return;
      }

      const sampleY = Math.min(64, Math.max(36, Math.round(window.innerHeight * 0.08)));
      let tone: 'light' | 'dark' = 'dark';
      let bestTop = -Infinity;

      surfaceNodes().forEach((el) => {
        const surface = ownSurface(el);
        if (!surface) return;
        const rect = el.getBoundingClientRect();
        if (rect.bottom <= sampleY || rect.top > sampleY) return;
        // Prefer the innermost / latest section covering the nav band
        if (rect.top >= bestTop) {
          bestTop = rect.top;
          tone = surface;
        }
      });

      root.dataset.navOn = tone;
    };

    const setHidden = (hidden: boolean) => {
      if (document.documentElement.classList.contains('nav-open')) {
        root.dataset.navHidden = 'false';
        if (bar) bar.dataset.navHidden = 'false';
        return;
      }
      const value = String(hidden);
      root.dataset.navHidden = value;
      if (bar) bar.dataset.navHidden = value;
    };

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      if (label) label.textContent = open ? closeLabel : openLabel;
      panel.dataset.state = open ? 'open' : 'closed';
      panel.hidden = !open;
      document.documentElement.classList.toggle('nav-open', open);
      if (open) setHidden(false);
      updateTone();

      if (lines.top && lines.mid && lines.bot) {
        if (open) {
          lines.top.style.transform = 'translateY(6.5px) rotate(45deg)';
          lines.mid.style.opacity = '0';
          lines.bot.style.transform = 'translateY(-6.5px) rotate(-45deg)';
        } else {
          lines.top.style.transform = '';
          lines.mid.style.opacity = '';
          lines.bot.style.transform = '';
        }
      }
    };

    // Always close after navigation / page load and show the bar
    setOpen(false);
    setHidden(false);
    closeAllLangMenus();
    requestAnimationFrame(updateTone);

    let lastY = window.scrollY;
    let ticking = false;

    const onFrame = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        const y = window.scrollY;
        updateTone();
        if (y < 32) {
          setHidden(false);
          lastY = y;
          ticking = false;
          return;
        }

        const delta = y - lastY;
        if (Math.abs(delta) >= 8) {
          // Scroll bas → disparaît ; scroll haut → revient
          setHidden(delta > 0);
          lastY = y;
        }
        ticking = false;
      });
    };

    const onToggle = () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return;
      closeAllLangMenus();
      if (toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    };

    const onResize = () => {
      if (window.matchMedia('(min-width: 768px)').matches) setOpen(false);
      closeAllLangMenus();
      updateTone();
    };

    toggle.addEventListener('click', onToggle);

    const panelLinks = [...panel.querySelectorAll('[data-nav-link]')];
    panelLinks.forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', onLangOutsideClick);
    document.addEventListener('keydown', onKeydown);
    window.addEventListener('resize', onResize);
    // Native scroll (fallback) + Lenis/Locomotive custom event from BaseLayout
    window.addEventListener('scroll', onFrame, { passive: true });
    window.addEventListener('mpichi:scroll', onFrame);

    // Geometry observer — works even when scroll events are swallowed
    const toneObserver = new IntersectionObserver(() => updateTone(), {
      root: null,
      rootMargin: '0px 0px -88% 0px',
      threshold: [0, 0.01, 0.1, 0.5, 1],
    });
    surfaceNodes().forEach((el) => {
      if (ownSurface(el)) toneObserver.observe(el);
    });

    navWindow.__mpichiNavCleanup = () => {
      toggle.removeEventListener('click', onToggle);
      document.removeEventListener('click', onLangOutsideClick);
      document.removeEventListener('keydown', onKeydown);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('scroll', onFrame);
      window.removeEventListener('mpichi:scroll', onFrame);
      getLangMenus().forEach((menu) => {
        menu
          .querySelector<HTMLButtonElement>('[data-lang-menu-trigger]')
          ?.removeEventListener('click', onLangTriggerClick);
      });
      toneObserver.disconnect();
    };
  }

  initSiteNav();
  document.addEventListener('astro:page-load', initSiteNav);
</script>

<style is:global>
  html.nav-open {
    overflow: hidden;
  }

  [data-site-nav] {
    --nav-ink: rgba(239, 229, 218, 0.88);
    --nav-ink-muted: rgba(239, 229, 218, 0.7);
    --nav-ink-strong: #ffffff;
  }

  [data-site-nav][data-nav-on='light'] {
    --nav-ink: #1a120e;
    --nav-ink-muted: rgba(18, 12, 9, 0.72);
    --nav-ink-strong: #120c09;
  }

  [data-site-nav] .nav-ink {
    color: var(--nav-ink);
  }

  [data-site-nav] .nav-ink-link {
    color: var(--nav-ink);
  }

  [data-site-nav] .nav-ink-link:hover,
  [data-site-nav] .nav-ink-active {
    color: var(--nav-ink-strong);
  }

  [data-site-nav] .nav-ink-muted {
    color: var(--nav-ink-muted);
  }

  [data-site-nav] .nav-ink-muted:hover {
    color: var(--nav-ink-strong);
  }

  [data-site-nav][data-nav-on='light'] [data-lang-menu-panel] {
    border-color: rgba(18, 12, 9, 0.12);
    background: rgba(245, 240, 233, 0.97);
    box-shadow: 0 12px 28px rgba(18, 12, 9, 0.12);
  }

  [data-site-nav][data-nav-on='light'] [data-lang-menu-panel] a {
    color: rgba(18, 12, 9, 0.55);
  }

