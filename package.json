{
  "name": "mpichi",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --port 4321 --strictPort --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "ci": "npm run check && npm run build",
    "astro": "astro",
    "sync-aliases": "cp mpichi-dataset/enrichment/aliases.json src/data/aliases.json",
    "export-dataset": "npm --prefix mpichi-dataset run export && npm run sync-aliases",
    "generate:ln": "npx tsx scripts/generate-ln-i18n.mts",
    "validate:ln": "npx tsx scripts/validate-ln.mts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.2.0",
    "locomotive-scroll": "^5.0.1",
    "tailwindcss": "^4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@vite-pwa/astro": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
